{
  "name": "terpgrid-server",
  "private": true,
  "version": "6.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/cli.js migrate",
    "keys:generate": "node dist/cli.js generate-key",
    "keys:rotate": "node dist/cli.js rotate-keys",
    "invite": "node dist/cli.js invite",
    "admin:promote": "node dist/cli.js promote",
    "argon2:bench": "node dist/cli.js bench-argon2",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
