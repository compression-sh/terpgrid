# restic-Konfiguration (Datei nach backup.env kopieren, chmod 600)
# Ziel möglichst außerhalb des VPS: z. B. sftp:user@backup-host:/terpgrid oder s3:…
RESTIC_REPOSITORY=sftp:backup@backup.example.org:/srv/restic/terpgrid
# Datei mit dem restic-Passwort (separat und offline sichern!)
RESTIC_PASSWORD_FILE=/root/.terpgrid-restic-password
# Aufbewahrung
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Optional: Benachrichtigung bei Fehlschlag. Der Befehl erhält die Meldung auf stdin
# (nie Secrets). Beispiele:
#   NOTIFY_CMD='curl -fsS -d @- https://ntfy.sh/mein-geheimer-kanal'
#   NOTIFY_CMD='mail -s "TERPGRID Backup" admin@example.org'
NOTIFY_CMD=
NOTIFY_ON_SUCCESS=false
