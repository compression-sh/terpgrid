# Statische SPA + Caddy (TLS, Sicherheits-Header, Reverse Proxy zur API).
FROM node:22.21-alpine3.22 AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY . .
RUN npm run build

FROM caddy:2.10.2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
# Caddy läuft als unprivilegierter Benutzer; Port 80/443 über Datei-Capability
RUN apk add --no-cache libcap && setcap cap_net_bind_service=+ep /usr/bin/caddy && apk del libcap \
 && addgroup -S -g 10001 caddy && adduser -S -D -H -u 10001 -G caddy caddy \
 && mkdir -p /data/caddy /config/caddy && chown -R caddy:caddy /data /config
USER caddy
