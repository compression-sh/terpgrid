[Unit]
Description=TERPGRID verschlüsseltes Backup (restic)
# Bei Fehlschlag (auch Absturz des Skripts) Benachrichtigungs-Unit starten
OnFailure=terpgrid-notify@%n.service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Pfad an den Installationsort anpassen
ExecStart=/opt/terpgrid/deploy/backup/backup.sh
Nice=10
IOSchedulingClass=idle
