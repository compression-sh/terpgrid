# TERPGRID – Beispielkonfiguration (keine Geheimnisse hier!)
# Secrets liegen als Dateien in ./secrets und werden von install.sh erzeugt.

# Öffentliche Domain (DNS-A/AAAA-Eintrag muss auf den VPS zeigen)
TERPGRID_DOMAIN=terpgrid.example.org

# Registrierung nur mit Einladung (empfohlen). false = öffentliche Registrierung.
INVITE_ONLY=true

# Speicher je Konto und maximale Uploadgröße
USER_QUOTA_MB=2048
MAX_UPLOAD_MB=20

# Online-Sortendaten (StrainAPI/CannaLib) über den Server-Proxy
CATALOG_PROXY_ENABLED=true

# Aktuelle Master-Key-Version (siehe docs/DEPLOYMENT.md → Schlüsselrotation)
MASTER_KEY_CURRENT=1

# Image-Tag (für Upgrade/Rollback)
TERPGRID_VERSION=3.0.0

# Ports (nur ändern, wenn ein anderer Reverse Proxy vorgeschaltet ist)
HTTP_PORT=80
HTTPS_PORT=443
