{
  "id": "./",
  "name": "TERPGRID",
  "short_name": "TERPGRID",
  "description": "Persönliches Cannabis-Dashboard: Growlogs, Fotos, Sorten, Journal und THC-Rechner.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07090a",
  "theme_color": "#07090a",
  "categories": ["lifestyle", "productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Schnellerfassung", "short_name": "Erfassen", "description": "Messung oder Beobachtung festhalten", "url": "./#/?erfassen=log", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Foto aufnehmen", "short_name": "Foto", "description": "Foto zu einem Grow hinzufügen", "url": "./#/?erfassen=photo", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Growlogs", "short_name": "Growlogs", "url": "./#/grows", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Discover", "short_name": "Discover", "url": "./#/discover", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
